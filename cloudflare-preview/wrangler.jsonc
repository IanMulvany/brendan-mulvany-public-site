{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brendan-mulvany-cloudflare-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "CACHE_VERSION": "2026-09-13-full-v1"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brendan-mulvany-preview-full",
      "database_id": "6d3afe2d-34ec-4193-98ca-6cef32e699e5",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "new.brendan-mulvany-photography.com",
      "custom_domain": true
    }
  ],
  "account_id": "91d1175698c21b3e4febe0a1b4642e4c"
}

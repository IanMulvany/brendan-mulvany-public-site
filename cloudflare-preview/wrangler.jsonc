{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brendan-mulvany-cloudflare-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "CACHE_VERSION": "2026-09-13-v1"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brendan-mulvany-preview",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "new.brendan-mulvany-photography.com",
      "custom_domain": true
    }
  ]
}

{
  "name": "brendan-mulvany-cloudflare-preview",
  "version": "1.0.0",
  "description": "Public photography archive on Cloudflare Workers and D1",
  "scripts": {
    "export": "python3 scripts/export-sample.py",
    "build": "node scripts/build.mjs",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:redirects": "wrangler deploy --config wrangler.redirects.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=data/seed.sql",
    "db:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 execute DB --remote --file=data/seed.sql",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "community:local": "wrangler d1 migrations apply COMMUNITY --local",
    "community:remote": "wrangler d1 migrations apply COMMUNITY --remote",
    "search:sync:local": "node scripts/sync-search.mjs --local",
    "search:sync:remote": "node scripts/sync-search.mjs --remote"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260911.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "private": true
}
